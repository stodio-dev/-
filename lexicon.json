{
  "version": "0.2",
  "modes": {
    "obs":  {"def": "directly observed/measured by the sender", "needs": ["src", "t"]},
    "inf":  {"def": "derived by reasoning from other statements", "needs": ["conf", "src", "t"]},
    "est":  {"def": "approximation of a present or past value; not a forecast (use pred)", "needs": ["conf", "src", "t"]},
    "pred": {"def": "forecast: the claim is expected to hold at some point within [t, t+dur]", "needs": ["conf", "src", "t", "dur"]},
    "unk":  {"def": "explicitly unknown; asks nothing, asserts nothing", "needs": ["src", "t"]},
    "req":  {"def": "request for information (answer expected)", "needs": ["src", "t"]},
    "cmd":  {"def": "instruction to perform an action", "needs": ["src", "t"]},
    "ack":  {"def": "receipt of statement @N confirmed; no agreement or completion implied; form: ack @N has recv", "needs": ["src", "t"]}
  },
  "relations": {
    "cause":   {"def": "A produced B (temporal + causal)", "not": "corr (co-occurrence only); need (dependency)"},
    "corr":    {"def": "A and B co-occur; no causal claim", "not": "cause"},
    "enable":  {"def": "A makes B possible but does not produce it", "not": "cause"},
    "block":   {"def": "A prevents B", "not": "cause (with ! it only says A did not produce B)"},
    "need":    {"def": "A cannot function without B", "not": "cause"},
    "part":    {"def": "A is a component of B", "not": "is (type membership)"},
    "is":      {"def": "A is an instance/kind of B", "not": "part, eq"},
    "eq":      {"def": "A and B are the same entity/value", "not": "sim (similar only)"},
    "sim":     {"def": "A resembles B in stated respect", "not": "eq"},
    "gt":      {"def": "A strictly greater than B", "not": "lt (reverse)"},
    "lt":      {"def": "A strictly less than B", "not": "gt (reverse)"},
    "bef":     {"def": "A happened strictly before B", "not": "cause"},
    "has":     {"def": "A holds/possesses property or value B", "not": "part"},
    "do":      {"def": "A performs action B", "not": "cause"},
    "to":      {"def": "A transfers/moves to B", "not": "do"}
  },
  "entities": {
    "agent":  {"def": "actor able to decide or act (person, program, org)", "not": "sys"},
    "sys":    {"def": "bounded technical system or machine", "not": "agent"},
    "data":   {"def": "information content, regardless of container", "not": "store"},
    "store":  {"def": "container that holds data (file, db, memory)", "not": "data"},
    "proc":   {"def": "ongoing or repeatable activity with steps", "not": "event"},
    "event":  {"def": "single occurrence at a point or short span in time", "not": "proc"},
    "res":    {"def": "consumable/limited capacity (cpu, memory, budget, time)", "not": "store"},
    "link":   {"def": "channel through which things move between parties", "not": "proc"},
    "rule":   {"def": "normative constraint or policy", "not": "fact"},
    "fact":   {"def": "descriptive claim about the world", "not": "rule"},
    "id":     {"def": "unique name or reference of something", "not": "data"},
    "val":    {"def": "a concrete number/value", "not": "id"},
    "time":   {"def": "instant or interval on a clock", "not": "res"},
    "place":  {"def": "location, physical or logical", "not": "id"}
  },
  "states": {
    "ok":     {"def": "operating as specified", "not": "idle"},
    "fail":   {"def": "not operating as specified", "not": "stop (deliberate)"},
    "stop":   {"def": "deliberately halted", "not": "fail"},
    "idle":   {"def": "available, doing nothing", "not": "ok"},
    "busy":   {"def": "fully engaged", "not": "fail"},
    "full":   {"def": "capacity exhausted", "not": "busy"},
    "empty":  {"def": "zero content", "not": "null (value absent)"},
    "null":   {"def": "value absent/undefined", "not": "empty"},
    "valid":  {"def": "conforms to a stated rule", "not": "true"},
    "true":   {"def": "matches reality", "not": "valid"},
    "safe":   {"def": "no unacceptable risk under stated threat model", "not": "valid"},
    "new":    {"def": "created and not yet changed", "not": "chg"},
    "chg":    {"def": "modified after creation", "not": "new"}
  },
  "actions": {
    "make":  {"def": "bring into existence", "not": "chg"},
    "kill":  {"def": "destroy irreversibly", "not": "halt (resumable)"},
    "set":   {"def": "assign a value", "not": "make"},
    "get":   {"def": "read without modifying", "not": "recv (accept something emitted)"},
    "send":  {"def": "emit toward a recipient", "not": "to (relation: A moves to B)"},
    "recv":  {"def": "accept something emitted", "not": "get"},
    "run":   {"def": "start execution", "not": "make"},
    "halt":  {"def": "stop execution (resumable)", "not": "kill"},
    "wait":  {"def": "suspend until a condition", "not": "halt"},
    "ask":   {"def": "solicit an answer", "not": "cmd"},
    "chk":   {"def": "verify against a rule or value", "not": "get"},
    "fix":   {"def": "restore to specified state", "not": "set"}
  },
  "quantifiers": {
    "all":  {"def": "every member of the set", "not": "some"},
    "some": {"def": "at least one, unspecified", "not": "all"},
    "one":  {"def": "exactly one", "not": "some"},
    "none": {"def": "zero members", "not": "null"},
    "many": {"def": "more than a few; vague (prefer a number)", "not": "all"}
  },
  "fields": {
    "conf":  {"def": "confidence 0..1 as decimal", "default": null},
    "src":   {"def": "identifier of the claimant", "default": null},
    "t":     {"def": "unix seconds of the claim, or +N meaning t0+N", "default": null},
    "t0":    {"def": "header only: base time in unix seconds for relative t=+N; not part of any statement", "default": null},
    "ctx":   {"def": "context the statement belongs to (incident, document, thread); letters, digits, . _ -", "default": null},
    "scope": {"def": "set the claim covers, a quantifier, e.g. scope=some", "default": "all"},
    "dur":   {"def": "seconds; the claim refers to the interval [t, t+dur]: pred = at some point within it, other modes = throughout it", "default": null},
    "unit":  {"def": "unit of measure for the value", "default": null},
    "q":     {"def": "verbatim free text, never paraphrased", "default": null}
  }
}
